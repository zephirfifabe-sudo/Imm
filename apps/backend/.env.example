# Base de données (SQLite en dev local, PostgreSQL en prod)
DATABASE_URL="file:./dev.db"

# Serveur
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="30d"

# Anthropic (analyse vision + synthèse) — jamais exposée côté mobile
ANTHROPIC_API_KEY=""
ANTHROPIC_VISION_MODEL="claude-sonnet-5"
ANTHROPIC_SYNTHESIS_MODEL="claude-sonnet-5"

# Stripe (mode test)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# CORS — origine de l'app mobile en dev (Expo)
CORS_ORIGIN="*"
