# --- Telegram (étape 3) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# --- Leaks : URL publique d'un canal Telegram qui reposte @FutSheriff (ex: https://t.me/s/futsheriff_leaks)
# Salon Discord dédié aux fodders (alertes de hausse + tableau) ; vide = salon principal
DISCORD_FODDER_WEBHOOK_URL=
# Salon Discord dédié aux leaks (webhook) ; vide = salon principal
DISCORD_LEAKS_WEBHOOK_URL=
# Canaux Telegram publics de leaks, séparés par des virgules (vide = aucun ; les leakers fiables sont sur X)
LEAK_CHANNELS=
# Plan B (optionnel) : instance Nitter + comptes à suivre
NITTER_URL=
NITTER_ACCOUNTS=FutSheriff
# --- Marché ---
GAME_YEAR=27
PLATFORM=console
PRICE_MIN=20250
PRICE_MAX=200000
WATCHLIST_SIZE=250
TZ=Europe/Paris
# --- Anti-bot ---
# auto = httpx puis Playwright si Cloudflare ; playwright = toujours navigateur
FETCH_MODE=auto
# Optionnel : FlareSolverr (http://flaresolverr:8191/v1) en 3e recours
FLARESOLVERR_URL=
# Optionnel : chemin explicite de chromium si la version Playwright ne correspond pas
PLAYWRIGHT_CHROMIUM_PATH=
# --- Discord (optionnel) ---
DISCORD_WEBHOOK_URL=
# --- Dashboard : FORTEMENT conseillé sur un VPS public (auth HTTP Basic) ---
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# --- Anti-spam ---
ALERT_MIN_CONFIDENCE=7
ALERT_MAX_PER_REPORT=8
ALERT_COOLDOWN_HOURS=6
MIN_NET_MARGIN=0.04
# --- Assistant Discord (voir README) ---
DISCORD_BOT_TOKEN=
# identifiant du salon des questions libres (clic droit sur le salon > Copier l'identifiant) ; vide = sur mention
DISCORD_BOT_CHANNEL_ID=
# IA au format OpenAI (Groq gratuit par défaut) ; LLM_MODEL vide = choix automatique
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_DAILY_LIMIT=50
# modèle avec recherche web (leaks, annonces) ; vide = désactivé
LLM_WEB_MODEL=groq/compound
# --- Moteur de décision ---
# v1 = moteur historique ; v2 = moteur fiabilisé (abstention, qualité des données). Retour arrière : BRAIN_VERSION=v1
BRAIN_VERSION=v2
# moteur évalué en observation (journalisé, jamais envoyé) ; vide = aucun
BRAIN_SHADOW=v1
# --- Si Cloudflare bloque l'IP du VPS ---
# 1) FlareSolverr (gratuit) : décommenter les 2 lignes puis `docker compose up -d`
#FLARESOLVERR_URL=http://flaresolverr:8191/v1
#COMPOSE_PROFILES=flaresolverr
# 2) Proxy résidentiel (payant) si l'IP est bannie : http://user:pass@host:port
PROXY_URL=
PRICE_REPORT_HOURS=10,22
# Répartition des joueurs suivis (laisser commenté pour la valeur par défaut, environ 410 joueurs)
#WATCHLIST_BANDS=20000-25000:40,25001-30000:40,30001-35000:35,35001-42000:40,42001-50000:40,50001-60000:35,60001-75000:40,75001-90000:35,90001-110000:30,110001-140000:30,140001-180000:25,180001-250000:20
