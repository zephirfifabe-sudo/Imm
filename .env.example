# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVEUR UNIQUEMENT. Ne jamais préfixer par NEXT_PUBLIC_,
# ne jamais exposer au frontend, ne jamais committer une vraie valeur.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — à renseigner en Phase 9 (abonnements)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# URL publique de l'application (utilisée pour les redirections auth, liens Stripe, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
