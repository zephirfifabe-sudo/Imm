# --- Telegram (étape 3) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# --- Leaks : URL publique d'un canal Telegram qui reposte @FutSheriff (ex: https://t.me/s/futsheriff_leaks)
LEAK_CHANNEL_URL=
# Plan B (optionnel) : instance Nitter + comptes à suivre
NITTER_URL=
NITTER_ACCOUNTS=FutSheriff
# --- Marché ---
GAME_YEAR=27
PLATFORM=console
PRICE_MIN=20000
PRICE_MAX=400000
WATCHLIST_SIZE=150
TZ=Europe/Paris
# --- Anti-bot ---
# auto = httpx puis Playwright si Cloudflare ; playwright = toujours navigateur
FETCH_MODE=auto
# Optionnel : FlareSolverr (http://flaresolverr:8191/v1) en 3e recours
FLARESOLVERR_URL=
# Optionnel : chemin explicite de chromium si la version Playwright ne correspond pas
PLAYWRIGHT_CHROMIUM_PATH=
