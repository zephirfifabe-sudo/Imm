# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVEUR UNIQUEMENT. Ne jamais préfixer par NEXT_PUBLIC_,
# ne jamais exposer au frontend, ne jamais committer une vraie valeur.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (abonnements) — clé secrète et secret de signature du webhook,
# depuis le Dashboard Stripe > Développeurs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price ID Stripe pour chaque plan (Dashboard Stripe > Produits > Prix).
# Changer un prix se fait dans Stripe, jamais dans le code.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PME=
STRIPE_PRICE_BUSINESS=

# URL publique de l'application (utilisée pour les redirections auth, liens Stripe, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
