# --- Telegram (étape 3) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# --- Leaks : URL publique d'un canal Telegram qui reposte @FutSheriff (ex: https://t.me/s/futsheriff_leaks)
LEAK_CHANNEL_URL=
# Plan B (optionnel) : instance Nitter + comptes à suivre
NITTER_URL=
NITTER_ACCOUNTS=FutSheriff
# --- Marché ---
GAME_YEAR=27
PLATFORM=console
PRICE_MIN=20250
PRICE_MAX=200000
WATCHLIST_SIZE=250
TZ=Europe/Paris
# --- Anti-bot ---
# auto = httpx puis Playwright si Cloudflare ; playwright = toujours navigateur
FETCH_MODE=auto
# Optionnel : FlareSolverr (http://flaresolverr:8191/v1) en 3e recours
FLARESOLVERR_URL=
# Optionnel : chemin explicite de chromium si la version Playwright ne correspond pas
PLAYWRIGHT_CHROMIUM_PATH=
# --- Discord (optionnel) ---
DISCORD_WEBHOOK_URL=
# --- Dashboard : FORTEMENT conseillé sur un VPS public (auth HTTP Basic) ---
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# --- Anti-spam ---
ALERT_MIN_CONFIDENCE=7
ALERT_MAX_PER_REPORT=8
ALERT_COOLDOWN_HOURS=6
MIN_NET_MARGIN=0.04
# --- Si Cloudflare bloque l'IP du VPS ---
# 1) FlareSolverr (gratuit) : décommenter les 2 lignes puis `docker compose up -d`
#FLARESOLVERR_URL=http://flaresolverr:8191/v1
#COMPOSE_PROFILES=flaresolverr
# 2) Proxy résidentiel (payant) si l'IP est bannie : http://user:pass@host:port
PROXY_URL=
PRICE_REPORT_HOURS=10,22
WATCHLIST_BANDS=20000-35000:50,35001-50000:50,50001-75000:45,75001-100000:45,100001-150000:35,150001-250000:25
